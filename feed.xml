---
layout: null
---
<?xml version="1.0" encoding="utf-8" ?>
<feed xmlns="http://www.w3.org/2005/Atom">

  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ site.url }}{{ site.baseurl }}/" rel="alternate"/>
  <link href="{{ site.url }}{{ site.baseurl }}/feed.xml" rel="self"/>
  <rights>Copyright @
    {{ site.time | date: '%Y' }},
    {{ site.author_name | xml_escape }}</rights>
  <icon>{{ site.url }}{{ site.baseurl }}/assets/favicon.png</icon>

  <author>
    <name>{{ site.author_name | xml_escape }}</name>
    <uri>{{ site.url }}</uri>
  </author>

  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url }}{{ site.baseurl }}/</id>
  <generator version="{{ jekyll.version }}">Jekyll</generator>

  {% for post in site.posts limit:40 %}

  {% assign content = post.content | replace: "&#8617;", "&#8617;&#xfe0e;" %}
  {% assign content = content | replace: "data-lang", "lang" %}
  {% assign content = content | replace: "<mark>", "<b>" | replace: "</mark>", "</b>" %}

  <entry>
    <title type="html">{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | prepend: site.baseurl | prepend: site.url }}" rel="alternate"/>
    <id>{{ post.url | prepend: site.baseurl | prepend: site.url }}</id>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <content type="html" xml:lang="en">
      <![CDATA[{{ content }}]]>
    </content>
  </entry>

  {% endfor %}

</feed>
